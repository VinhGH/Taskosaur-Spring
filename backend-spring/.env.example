# =============================================
# TASKOSAUR SPRING BOOT - Environment Config
# =============================================
# Dựa trên .env gốc của Taskosaur NestJS + bổ sung cho Spring Boot

# =============================================
# DATABASE (PostgreSQL)
# =============================================
POSTGRES_USER=taskosaur
POSTGRES_PASSWORD=taskosaur
POSTGRES_DB=taskosaur

# JDBC URL cho Spring Boot
# Nếu dùng Docker: đổi localhost -> postgres (tên service trong docker-compose)
# Nếu dùng local PostgreSQL port mặc định: đổi 5435 -> 5432
SPRING_DATABASE_URL=jdbc:postgresql://localhost:5435/taskosaur?stringtype=unspecified&options=-c%20timezone%3DUTC

# =============================================
# SERVER
# =============================================
SERVER_PORT=3000
NODE_ENV=development

# =============================================
# JWT Authentication & Security
# =============================================
# Tạo secret ngẫu nhiên bằng: openssl rand -base64 32
JWT_SECRET=jq2Npnpp0pl9tuKowA1opDBXtjgsrxxOm87rNEgFv5SYAnzF
JWT_REFRESH_SECRET=evbRTnQhWPqpgZSoVA4uQXKuFjw0UdtmYrvJaGdj6xlxbZp9

# Thời gian hết hạn token (ms) - 15 phút = 900000ms, 7 ngày = 604800000ms
JWT_ACCESS_EXPIRY_MS=900000
JWT_REFRESH_EXPIRY_MS=604800000

# Dùng cho NestJS gốc (giữ lại để tương thích)
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Encryption key (dùng cho NestJS gốc)
ENCRYPTION_KEY=Nj9vBnl9xBzZFwPAHe2FTq0x7H1cNeAuuYkqu45r4kP4DAoR

# =============================================
# FRONTEND & CORS
# =============================================
FRONTEND_URL=http://localhost:3001
CORS_ORIGIN=http://localhost:3001

# URL API cho FE gọi vào BE (NestJS gốc)
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000/api

# =============================================
# REDIS (dùng cho NestJS BullMQ Queue)
# =============================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# =============================================
# EMAIL / SMTP (optional)
# =============================================
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-email@taskosaur.com
SMTP_PASS=your-app-password
SMTP_FROM=noreply@taskosaur.com
EMAIL_DOMAIN=taskosaur.com

# =============================================
# FILE UPLOAD
# =============================================
UPLOAD_DEST=./uploads
MAX_FILE_SIZE=10485760

# =============================================
# QUEUE (NestJS BullMQ)
# =============================================
MAX_CONCURRENT_JOBS=5
JOB_RETRY_ATTEMPTS=3

# =============================================
# AI - OpenRouter Configuration
# =============================================
# 1. Đăng ký tại: https://openrouter.ai
# 2. Vào Keys -> Create Key -> Copy key bắt đầu bằng sk-or-...
OPENROUTER_API_KEY=sk-or-your-key-here

# URL API của OpenRouter (không cần đổi)
OPENROUTER_API_URL=https://openrouter.ai/api/v1

# Model mặc định - Xem danh sách tại: https://openrouter.ai/models
# openai/gpt-4o-mini        <- Rẻ nhất, nhanh nhất (khuyên dùng khi dev)
# openai/gpt-4o             <- Mạnh hơn, đắt hơn
# anthropic/claude-3-5-haiku-20241022 <- Viết mô tả rất tốt
# google/gemini-2.0-flash-001         <- Nhanh, rẻ, tiếng Việt khá tốt
OPENROUTER_MODEL=openai/gpt-4o-mini

# Giới hạn token và timeout
AI_MAX_TOKENS=4000
AI_REQUEST_TIMEOUT_MS=60000

# =============================================
# LOGGING (Spring Boot)
# =============================================
SPRING_JPA_SHOW_SQL=true
