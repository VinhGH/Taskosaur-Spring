# =============================================
# TASKOSAUR - Environment Configuration
# =============================================
# Copy file này sang .env rồi điền giá trị thật:
#   cp .env.example .env
#
# Tạo secret ngẫu nhiên:
#   openssl rand -base64 32   (cho JWT secrets)
#   openssl rand -hex 32      (cho ENCRYPTION_KEY)
# =============================================

# =============================================
# DATABASE (PostgreSQL)
# =============================================
POSTGRES_USER=taskosaur
POSTGRES_PASSWORD=taskosaur
POSTGRES_DB=taskosaur

# Prisma / NestJS
DATABASE_URL=postgresql://taskosaur:taskosaur@localhost:5432/taskosaur

# Spring Boot (JDBC) - Docker: doi localhost -> postgres
SPRING_DATABASE_URL=jdbc:postgresql://localhost:5432/taskosaur?stringtype=unspecified&options=-c%20timezone%3DUTC

# =============================================
# SERVER
# =============================================
NODE_ENV=development
HOST=0.0.0.0
SERVER_PORT=3000

# =============================================
# JWT Authentication & Security
# =============================================
JWT_SECRET=CHANGE_ME_run_openssl_rand_-base64_32
JWT_REFRESH_SECRET=CHANGE_ME_run_openssl_rand_-base64_32
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_ACCESS_EXPIRY_MS=900000
JWT_REFRESH_EXPIRY_MS=604800000
ENCRYPTION_KEY=CHANGE_ME_run_openssl_rand_-hex_32

# =============================================
# FRONTEND & CORS
# =============================================
FRONTEND_URL=http://localhost:3001
CORS_ORIGIN=http://localhost:3001
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000/api

# =============================================
# REDIS
# =============================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# =============================================
# EMAIL / SMTP (optional)
# =============================================
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-email@taskosaur.com
SMTP_PASS=your-app-password
SMTP_FROM=noreply@taskosaur.com
EMAIL_DOMAIN=taskosaur.com

# =============================================
# FILE UPLOAD
# =============================================
UPLOAD_DEST=./uploads
MAX_FILE_SIZE=10485760
MAX_EDITOR_IMAGE_SIZE=5242880
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/gif,image/webp
EDITOR_IMAGE_UPLOAD_FOLDER=editor-images

# =============================================
# QUEUE (BullMQ)
# =============================================
MAX_CONCURRENT_JOBS=5
JOB_RETRY_ATTEMPTS=3
BULL_BOARD_EMAIL=admin@taskosaur.com
BULL_BOARD_PASSWORD=CHANGE_ME_strong_password

# =============================================
# AI - OpenRouter
# =============================================
# Dang ky tai: https://openrouter.ai -> Keys -> Create Key
OPENROUTER_API_KEY=sk-or-your-key-here
OPENROUTER_API_URL=https://openrouter.ai/api/v1
# Model goi y: openai/gpt-4o-mini | google/gemini-2.0-flash-001
OPENROUTER_MODEL=openai/gpt-4o-mini
AI_MAX_TOKENS=4000
AI_REQUEST_TIMEOUT_MS=60000

# =============================================
# JIRA INTEGRATION (optional)
# =============================================
# JIRA_ALLOWED_HOSTS=*.atlassian.net

# =============================================
# AWS S3 (optional)
# =============================================
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_REGION=us-east-1
AWS_BUCKET_NAME=your-bucket-name

# =============================================
# LOGGING (Spring Boot)
# =============================================
SPRING_JPA_SHOW_SQL=false
