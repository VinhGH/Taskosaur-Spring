{
    "name": "@taskosaur/platform",
    "version": "0.1.0",
    "description": "Taskosaur Platform - Open Source Project Management with Conversational AI Task Execution",
    "author": "Taskosaur Team",
    "private": true,
    "license": "SEE LICENSE IN https://github.com/Taskosaur/Taskosaur/blob/main/LICENSE.md",
    "workspaces": [
        "frontend",
        "database"
    ],
    "engines": {
        "node": ">=22.0.0",
        "npm": ">=10.0.0"
    },
    "scripts": {
        "dev": "concurrently -n frontend,backend -c cyan,magenta \"npm run dev:frontend\" \"npm run dev:backend\"",
        "dev:frontend": "npm run dev --workspace=frontend",
        "dev:backend": "cd backend && .\\mvnw.cmd spring-boot:run",
        "build": "npm run build:frontend && npm run build:backend",
        "build:frontend": "npm run build --workspace=frontend",
        "build:backend": "cd backend && .\\mvnw.cmd clean package -DskipTests",
        "test": "npm run test:frontend",
        "test:frontend": "npm run test --workspace=frontend",
        "test:backend": "cd backend && .\\mvnw.cmd test",
        "lint": "npm run lint:frontend",
        "lint:frontend": "npm run lint --workspace=frontend",
        "db:migrate": "dotenv -- npm run prisma:migrate:dev --workspace=database",
        "db:migrate:deploy": "dotenv -- npm run prisma:migrate:deploy --workspace=database",
        "db:reset": "dotenv -- npm run prisma:reset --workspace=database",
        "db:generate": "dotenv -- npm run prisma:generate --workspace=database",
        "db:studio": "dotenv -- npm run prisma:studio --workspace=database",
        "prisma": "dotenv -- npm run prisma --workspace=database",
        "clean": "npm run clean:frontend && shx rm -rf node_modules dist out .next",
        "clean:frontend": "npm run clean --workspace=frontend",
        "clean:backend": "cd backend && .\\mvnw.cmd clean",
        "generate:logo:icons": "node scripts/generate-logo-icons.js",
        "postinstall": "node scripts/postinstall.js",
        "prepare": "husky"
    },
    "keywords": [],
    "devDependencies": {
        "concurrently": "^9.2.1",
        "dotenv-cli": "^7.4.2",
        "husky": "^9.1.7",
        "shx": "^0.3.4",
        "to-ico": "^1.1.5"
    },
    "dependencies": {}
}
